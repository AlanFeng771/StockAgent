FINMIND_API_TOKEN=your_finmind_token_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
DAILY_ANALYSIS_HOUR=17
DAILY_ANALYSIS_MINUTE=0
# 以下皆可省略，省略時使用 backend/app/config.py 的預設值
# DATABASE_URL=sqlite:///./data/stockagent.db
# OPENAI_TEMPERATURE=0.2
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_REPAIR_ATTEMPTS=1
# FinMind 快取：近期資料有效秒數 / 區間結束日早於今天N天以上視為定案 / 超過N天未更新的快取檔自動刪除
# CACHE_DIR=data/cache
# CACHE_TTL_SECONDS=3600
# CACHE_FINAL_AFTER_DAYS=3
# CACHE_MAX_AGE_DAYS=14
# 聊天：模型 / 工具呼叫最多輪數 / 摘要模型 / 保留最近原文則數 / 每N則新訊息總結一次 / 危險動作確認有效分鐘數
# CHAT_MODEL=gpt-4o
# CHAT_MAX_TOOL_ROUNDS=5
# CHAT_SUMMARY_MODEL=gpt-4o-mini
# CHAT_RECENT_MESSAGES=10
# CHAT_SUMMARY_EVERY=20
# CHAT_ACTION_TTL_MINUTES=10
